{
  "test_script_generation": {
    "check_mode": "strict",
    "warn_threshold": 3,
    
    "structure": {
      "enabled": true,
      "require_imports": true,
      "require_test_framework_import": true,
      "require_module_import": true,
      "require_describe": true,
      "require_test_cases": true,
      "require_setup_teardown": false
    },
    
    "code_quality": {
      "enabled": true,
      "max_test_case_lines": 20,
      "require_factory_functions": true,
      "forbid_hardcoded_data": true,
      "forbid_syntax_errors": true,
      "require_meaningful_names": true
    },
    
    "naming": {
      "enabled": true,
      "file_pattern": "{name}.test.{ext}",
      "describe_pattern": "{unit_name}",
      "test_case_pattern": "{type}-{seq:03d}: should {behavior}",
      "min_description_length": 10,
      "max_description_length": 100,
      "require_test_point_prefix": true,
      "description_language": "business"
    },
    
    "imports": {
      "enabled": true,
      "require_module_import": true,
      "require_test_framework": true,
      "forbid_nonexistent_imports": true,
      "require_correct_paths": true,
      "forbid_circular_dependencies": true
    },
    
    "assertions": {
      "enabled": true,
      "min_assertions_per_test": 1,
      "require_meaningful_assertions": true,
      "forbid_empty_assertions": true,
      "require_result_verification": true,
      "assertion_types": [
        "toBe",
        "toEqual",
        "toThrow",
        "toHaveBeenCalled",
        "rejects"
      ]
    },
    
    "mocks": {
      "enabled": true,
      "require_external_mocks": true,
      "require_mock_setup": true,
      "require_mock_cleanup": true,
      "require_mock_verification": false,
      "forbid_core_logic_mocks": true,
      "require_realistic_mock_data": true
    },
    
    "isolation": {
      "enabled": true,
      "require_before_each": false,
      "require_after_each": true,
      "require_independent_data": true,
      "forbid_shared_state": true,
      "require_parallel_safe": true,
      "require_resource_cleanup": true
    },
    
    "async": {
      "enabled": true,
      "require_async_await": true,
      "forbid_unhandled_promises": true,
      "require_error_handling": true,
      "max_timeout_ms": 5000
    },
    
    "performance": {
      "enabled": true,
      "max_unit_test_ms": 100,
      "max_integration_test_ms": 1000,
      "max_e2e_test_ms": 10000,
      "forbid_unnecessary_delays": true,
      "require_mock_for_io": true
    },
    
    "type_safety": {
      "enabled": true,
      "require_type_check": true,
      "forbid_any_type": true,
      "require_type_guards": true,
      "require_mock_types": true
    },
    
    "error_handling": {
      "enabled": true,
      "require_error_tests": true,
      "require_error_assertions": true,
      "require_error_type_verification": false,
      "require_error_message_verification": false,
      "require_boundary_tests": true
    },
    
    "maintainability": {
      "enabled": true,
      "require_helper_functions": true,
      "require_constants": true,
      "max_code_duplication": 30,
      "require_comments": false,
      "require_factory_functions": true
    },
    
    "configuration": {
      "enabled": true,
      "require_test_config": true,
      "require_coverage_config": false,
      "require_path_aliases": false
    },
    
    "test_point_mapping": {
      "enabled": true,
      "require_m_tests": true,
      "require_f_tests": false,
      "require_q_tests": false,
      "test_point_naming_pattern": "{type}-{seq:03d}: {description}",
      "test_point_types": ["M", "F", "Q"],
      "m_test_requirements": {
        "min_count": 3,
        "require_positive": true,
        "require_boundary": true,
        "require_negative": true
      },
      "f_test_requirements": {
        "min_count": 1,
        "method": "pairwise"
      },
      "q_test_requirements": {
        "min_count": 1,
        "categories": [
          "performance",
          "security",
          "concurrency"
        ]
      }
    }
  },
  
  "project_type": "web",
  
  "web_app": {
    "check_mode": "strict",
    "structure": {
      "require_setup_teardown": true
    },
    "performance": {
      "max_unit_test_ms": 100,
      "max_integration_test_ms": 1000
    },
    "test_point_mapping": {
      "require_m_tests": true,
      "require_f_tests": false,
      "require_q_tests": false
    }
  },
  
  "cli_tool": {
    "check_mode": "strict",
    "performance": {
      "max_unit_test_ms": 100
    },
    "test_point_mapping": {
      "require_m_tests": true,
      "require_f_tests": false,
      "require_q_tests": false
    },
    "type_safety": {
      "enabled": false
    }
  },
  
  "library": {
    "check_mode": "strict",
    "performance": {
      "max_unit_test_ms": 50,
      "max_integration_test_ms": 500
    },
    "test_point_mapping": {
      "require_m_tests": true,
      "require_f_tests": true,
      "require_q_tests": true
    },
    "m_test_requirements": {
      "min_count": 5
    }
  },
  
  "check_priorities": {
    "critical": [
      "structure.forbid_syntax_errors",
      "imports.forbid_nonexistent_imports",
      "assertions.min_assertions_per_test",
      "mocks.forbid_core_logic_mocks",
      "isolation.forbid_shared_state",
      "async.forbid_unhandled_promises",
      "type_safety.require_type_check"
    ],
    "important": [
      "naming.require_test_point_prefix",
      "mocks.require_external_mocks",
      "isolation.require_independent_data",
      "error_handling.require_error_tests"
    ],
    "optional": [
      "performance.max_unit_test_ms",
      "maintainability.max_code_duplication",
      "configuration.require_coverage_config"
    ]
  },
  
  "reporting": {
    "enabled": true,
    "format": "detailed",
    "output_file": "test-script-check-report.json",
    "show_warnings": true,
    "show_suggestions": true
  }
}
